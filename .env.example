APPS_SCRIPT_TOKEN=cole-aqui-o-mesmo-API_TOKEN-do-apps-script
# Opcional: restringe gravações (POST) ao domínio oficial
ALLOWED_ORIGIN=https://patrimonio-dashboard.vercel.app
